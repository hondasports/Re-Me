{
  "name": "re-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:full": "vite dev",
    "build": "node scripts/cloudflare-build.mjs local",
    "build:preview": "node scripts/cloudflare-build.mjs preview",
    "build:production": "node scripts/cloudflare-build.mjs production",
    "preview": "vite preview",
    "deploy": "pnpm deploy:preview",
    "deploy:preview": "pnpm build:preview && node scripts/cloudflare-deploy.mjs preview",
    "deploy:production": "pnpm build:production && node scripts/cloudflare-deploy.mjs production",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "d1:migrations:apply:local": "wrangler d1 migrations apply re-me-local --local",
    "test:loop": "vitest run --config vitest.loop.config.mjs",
    "loop:preflight": "node scripts/check-task-worktree.mjs --require-clean",
    "loop:check-task-state-template": "node scripts/check-task-state-template.mjs --staged",
    "loop:e2e-env": "node scripts/sync-worktree-e2e-env.mjs",
    "loop:e2e-gate": "node scripts/check-local-e2e-gate.mjs",
    "loop:aftercare": "node scripts/check-pr-aftercare.mjs",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local --no-seed --yes",
    "db:lint": "supabase db lint --local --level warning",
    "db:advisors": "supabase db advisors --local --type all --level warn --fail-on warn",
    "db:types": "supabase gen types --local --schema public > supabase/database.generated.ts",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.24.1",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@mantine/core": "^8.3.2",
    "@mantine/hooks": "^8.3.2",
    "@mantine/notifications": "^8.3.2",
    "@tanstack/react-query": "^5.102.8",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "jpeg-js": "^0.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "supabase": "2.115.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.1.2"
}
